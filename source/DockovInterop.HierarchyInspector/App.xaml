<Application x:Class="DockovInterop.HierarchyInspector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#333333" />
    <SolidColorBrush x:Key="CardBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#202020" />
    <SolidColorBrush x:Key="TextBrush" Color="#D8D8D8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9B9B9B" />
    <SolidColorBrush x:Key="InputBrush" Color="#292929" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3A78B8" />

    <Style TargetType="Control">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#1D1D1D" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#454545" />
      <Setter Property="BorderBrush" Value="#222222" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Padding" Value="1" />
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#202020" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#555555" />
    </Style>
  </Application.Resources>
</Application>
