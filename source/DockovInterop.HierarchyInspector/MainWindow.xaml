<Window x:Class="DockovInterop.HierarchyInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockovInterop.HierarchyInspector"
        Title="Duckov Hierarchy Inspector" Width="1180" Height="760"
        MinWidth="800" MinHeight="520"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:HierarchyItem}" ItemsSource="{Binding Children}">
            <Grid Height="22" ToolTip="{Binding Detail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="9" Height="9" CornerRadius="1" Background="{Binding MarkerBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{Binding ForegroundBrush}" />
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="30" Height="28" Padding="0" Command="{Binding RefreshCommand}" ToolTip="Refresh scene snapshot">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE72C;" />
                </Button>
                <TextBox Grid.Column="2" Height="28" VerticalContentAlignment="Center"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter hierarchy by name" />
                <TextBlock Grid.Column="2" Text="Filter hierarchy" Foreground="{StaticResource DisabledTextBrush}" Margin="7,0" VerticalAlignment="Center"
                   IsHitTestVisible="False" Visibility="{Binding IsFilterHintVisible}" />
                <Button x:Name="HierarchyFilterButton" Grid.Column="4" Width="30" Height="28" Padding="0"
                        Click="HierarchyFilterButton_OnClick" ToolTip="Hierarchy filters">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE71C;" />
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Hide inactive objects" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding HideDisabledObjects, Mode=TwoWay}" />
                            <MenuItem Header="Hide objects without renderers" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding HideObjectsWithoutRenderers, Mode=TwoWay}" />
                            <MenuItem Header="Hide non-UI objects" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding HideNonUiObjects, Mode=TwoWay}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="230" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Hierarchy" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                    </Border>
                    <TreeView Grid.Row="1" ItemsSource="{Binding Hierarchy}" SelectedItemChanged="Hierarchy_OnSelectedItemChanged"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" Padding="4,5" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Background="{StaticResource WindowBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="10,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Components" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="26" Height="24" Padding="0"
                                    Command="{Binding RefreshComponentsCommand}" ToolTip="Refresh components">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE72C;" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="6" RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="Select a GameObject in the Hierarchy" Foreground="{StaticResource MutedTextBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding EmptySelectionVisibility}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding InspectorVisibility}">
                            <StackPanel Margin="10">
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="7" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding SelectedObject.ActiveSelf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding SelectedObject.CanEditActive}" Margin="0,0,7,0"
                            ToolTip="Activate or deactivate this GameObject" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedObject.Name, Mode=OneWay}" IsReadOnly="True" FontWeight="SemiBold" />
                                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Tag" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding SelectedObject.Tag, Mode=OneWay}" IsReadOnly="True" />
                                            <TextBlock Grid.Column="2" Text="Layer" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding SelectedObject.Layer, Mode=OneWay}" IsReadOnly="True" />
                                        </Grid>
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding SelectedObject.ActivationError}"
                                Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                Visibility="{Binding SelectedObject.ActivationErrorVisibility}" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding SelectedObject.Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="2" Margin="0,0,0,8">
                                                <Grid>
                                                    <Expander IsExpanded="True">
                                                        <Expander.Header>
                                                            <Grid Height="30">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ShortType}" Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="10" VerticalAlignment="Center" Margin="10,0,8,0" />
                                                            </Grid>
                                                        </Expander.Header>
                                                        <StackPanel Margin="8,2,8,9">
                                                            <Border Background="{StaticResource ErrorBackgroundBrush}" Padding="6,4" Margin="0,2,0,6" Visibility="{Binding ErrorVisibility}">
                                                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <local:InspectorFieldView />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="No serialized fields" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                                        Margin="4" Visibility="{Binding EmptyFieldsVisibility}" />
                                                        </StackPanel>
                                                    </Expander>
                                                    <CheckBox Panel.ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,9,0,0"
                                    IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanEditEnabled}" Visibility="{Binding EnabledVisibility}"
                                    ToolTip="Enable or disable this component" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource OverlayBrush}" Visibility="{Binding BusyVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                            <TextBlock Text="Reading scene hierarchy..." Margin="0,10,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SnapshotTimeText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
